                    profile

                );

            }

            this.saveUsersCache();

        }

        return response;

    }

    catch (error) {

        return this.handleError(

            error,

            "Update User"

        );

    }

};


/* =====================================================
   RESET USER ACCOUNT
===================================================== */

Admin.resetUserAccount = async function (

