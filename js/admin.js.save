    dailyBonus: true,

    spinWheel: true,

    mysteryBox: true,

    luckyDraw: true,

    leaderboard: true,

    notifications: true,

    miniApp: true

};


/* =====================================================
   LOAD FEATURE FLAGS
===================================================== */

