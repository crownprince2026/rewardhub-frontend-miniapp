/* =====================================================
   LOAD STATISTICS
===================================================== */

Admin.loadStatistics = async function () {

    try {

        const response =

            await API.getAdminStatistics();

        if (

            !response.success

        ) {

            return response;

        }

        this.statistics = {

            ...this.statistics,

            ...(response.statistics || {})

        };

        return response;

    }

    catch (error) {

        return this.handleError(

            error,

            "Statistics"

        );

    }

};


/* =====================================================
   UPDATE STATISTICS
===================================================== */

Admin.updateStatistics = function (

    data = {}

) {

    this.statistics = {

        ...this.statistics,

        ...data

    };

};


