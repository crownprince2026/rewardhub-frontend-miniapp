            "Debit Wallet"

        );

    }

};


/* =====================================================
   UPDATE USER PROFILE
===================================================== */

Admin.updateUserProfile = async function (

    userId,

    profile = {}

) {

    try {

        this.verifyAccess(

            ADMIN_PERMISSIONS.USERS

        );

        const response =

            await API.updateUserProfile({

                userId,

                profile

            });

        if (

            response.success

        ) {

            const user =

                this.getUser(

                    userId

                );

            if (

                user

            ) {

                Object.assign(

