/* =====================================================
   EXECUTE QUICK ACTION
===================================================== */

Admin.runQuickAction = function (

    id

) {

    const action =

        this.quickActions.find(

            item =>

                item.id === id

        );

    if (

        action

    ) {

        action.action();

    }

};


/* =====================================================
   DASHBOARD OVERVIEW
===================================================== */

Admin.getDashboardOverview = function () {

    this.updateDashboardCards();

    return {

        cards:

            this.dashboardCards,

        kpis:

            this.getKPIs(),

        widgets:

            this.widgets,

        quickActions:

            this.quickActions

    };

};


