    try {

        this.verifyAccess(

            ADMIN_PERMISSIONS.SETTINGS

        );

        const response =

            await API.getFeatureFlags();

        if (

            response.success

        ) {

            this.featureFlags = {

                ...this.featureFlags,

                ...(response.flags || {})

            };

            this.saveSystemSettingsCache();

        }

        return response;

    }

    catch (error) {

        return this.handleError(

            error,

